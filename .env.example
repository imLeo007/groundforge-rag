PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5433

POSTGRES_DB=ground_forge_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://postgres:your_database_password@db:5432/ground_forge_db

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_K=10

GEMINI_MODEL=gemini/gemini-3.6-flash
GROQ_MODEL=groq/qwen/qwen3.8-27b
AI_CREDITS_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL=openrouter/free

AI_CREDITS_API_KEY=your_ai_credits_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_API_KEY=your_gemini_api_key